config_version=5

[application]
config/name="Camp Story Character Check"
run/main_scene="res://main.tscn"

[display]
window/size/viewport_width=1400
window/size/viewport_height=860
window/size/window_width_override=1400
window/size/window_height_override=860

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.85, 0.85, 0.81, 1)
